# Copia este archivo a .env para desarrollo local: cp .env.example .env

# Contraseña compartida para entrar a la app (cámbiala!).
APP_PASSWORD=cambiame

# Secreto para firmar la sesión. Usa una cadena larga y aleatoria.
SESSION_SECRET=pon-aqui-algo-largo-y-aleatorio

# Puerto local (Railway lo asigna automáticamente en producción).
PORT=3000

# Base de datos. En local puedes dejarlo vacío (usa memoria) o apuntar a
# un PostgreSQL. En Railway se llena solo con la referencia de PostgreSQL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Pon en 'true' solo si te conectas a Postgres por el proxy público (SSL).
# DATABASE_SSL=false
